{
  "manifest_version": 3,
  "name": "Play On Youtube",
  "version": "1.0.0",
  "description": "Right-click selected text to play the first YouTube search result.",
  "permissions": ["contextMenus", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alontiti9@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
